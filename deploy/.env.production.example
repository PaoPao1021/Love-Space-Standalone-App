LOVESPACE_DOMAIN=love.example.com

DB_USERNAME=lovespace
DB_PASSWORD=replace-with-random-database-password
DB_ROOT_PASSWORD=replace-with-different-random-root-password
JWT_SECRET=replace-with-at-least-32-random-bytes

S3_INTERNAL_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com
S3_PUBLIC_ENDPOINT=https://lovespace-private.oss-cn-hongkong.aliyuncs.com
S3_REGION=cn-hongkong
S3_BUCKET=lovespace-private
S3_ACCESS_KEY=replace-with-ram-access-key
S3_SECRET_KEY=replace-with-ram-secret
S3_PATH_STYLE_ACCESS_ENABLED=false
S3_CHUNKED_ENCODING_ENABLED=false

PUSH_DELIVERY_ENABLED=true
GETUI_APP_ID=replace-with-getui-app-id
GETUI_APP_KEY=replace-with-getui-app-key
GETUI_MASTER_SECRET=replace-with-getui-master-secret
VAPID_PUBLIC_KEY=replace-with-url-safe-vapid-public-key
VAPID_PRIVATE_KEY=replace-with-url-safe-vapid-private-key
VAPID_SUBJECT=mailto:owner@example.com

LOVESPACE_BACKUP_PASSWORD=replace-with-long-random-backup-password
OSSUTIL_CONFIG_FILE=/root/.ossutilconfig
