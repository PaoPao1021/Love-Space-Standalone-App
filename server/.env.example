# 仅供本地开发参考；生产环境必须替换所有凭据并使用 prod Profile。
SPRING_PROFILES_ACTIVE=dev
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

DB_URL=jdbc:mysql://localhost:3306/lovespace?useUnicode=true&characterEncoding=utf8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
DB_USERNAME=lovespace
DB_PASSWORD=lovespace-local
JWT_SECRET=replace-with-at-least-32-random-bytes
DEV_AUTH_SECRET=local-only
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# One-time account initialization. Run with web-application-type=none, then remove these values.
LOVESPACE_BOOTSTRAP_ENABLED=false
LOVESPACE_BOOTSTRAP_USER_A=
LOVESPACE_BOOTSTRAP_PASSWORD_A=
LOVESPACE_BOOTSTRAP_NICKNAME_A=Partner A
LOVESPACE_BOOTSTRAP_USER_B=
LOVESPACE_BOOTSTRAP_PASSWORD_B=
LOVESPACE_BOOTSTRAP_NICKNAME_B=Partner B
LOVESPACE_BOOTSTRAP_START_DATE=

# Legacy mini-program integration stays disabled for the Flutter/PWA deployment.
WX_APP_ID=
WX_APP_SECRET=
ORDER_TEMPLATE_ID=
ANNIVERSARY_TEMPLATE_ID=
WECHAT_INTEGRATIONS_ENABLED=false

# Java 服务访问对象存储的地址；签名 URL 使用下方公开地址。
S3_INTERNAL_ENDPOINT=http://localhost:9090
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9090
S3_REGION=us-east-1
S3_BUCKET=lovespace
S3_ACCESS_KEY=local
S3_SECRET_KEY=local
S3_PATH_STYLE_ACCESS_ENABLED=true
S3_CHUNKED_ENCODING_ENABLED=true

# Push delivery stays off locally. Production secrets are environment-only.
PUSH_DELIVERY_ENABLED=false
PUSH_WORKER_DELAY=15s
GETUI_APP_ID=
GETUI_APP_KEY=
GETUI_MASTER_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost
